# Copy to /etc/goat-cam.env on the Raspberry Pi and fill in the values.
# Keep this file on the Pi only. Do not commit the real one.

# Camera stream. Create a Camera Account in the Tapo app first (not your Tapo login).
CAM_RTSP_URL=rtsp://CAMERA_ACCOUNT:CAMERA_PASSWORD@192.168.1.50:554/stream2

# Folder served publicly through the Cloudflare Tunnel
CAM_PUBLISH_DIR=/var/www/goat-cam

# Working folder for the temporary frame
CAM_WORK_DIR=/var/lib/goat-cam

# Person detector model (downloaded once, see README)
CAM_MODEL=/opt/goat-cam/yolov8n.pt

# Lower = safer (more frames blocked), higher = fewer false alarms
CAM_PERSON_THRESHOLD=0.25

# No snapshots between these local hours (22:00 to 06:00). Leave empty for all day.
CAM_QUIET_HOURS=

# Port the local web server listens on (cloudflared connects to it)
CAM_WEB_PORT=8080
